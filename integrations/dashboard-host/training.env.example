# Dedicated instructor build only. Add actual secrets in secure deployment settings.
# These are examples, not an instruction to activate or deploy during branch work.
FORGE_TRAINING_BUILD=true
NEXT_PUBLIC_TRAINING_BASE_PATH=/instructor-training
TRAINING_SIGN_IN_ENABLED=true
RECRUITMENT_EMAIL_LOGIN_ENABLED=true
RECRUITMENT_BACKEND_ENABLED=false

# Leave automation disabled until the published app path has been tested.
